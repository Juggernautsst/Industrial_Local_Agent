@startuml
!include style.puml
top to bottom direction

rectangle "PROTECTED INTRANET" as Intranet #F4F8FB {
  rectangle "Researcher" as User #F1F7F3
  rectangle "MCP" as MCP #FFF6E8
  rectangle "Release Gate" as Release #FFF6E8
  rectangle "Audit" as Audit #F5F5F5
  rectangle "Sole Egress" as Egress #F5F5F5
}

rectangle "EXTERNAL" as External #FFF9EF {
  rectangle "External Application" as ExternalApp #FFF6E8
  rectangle "External Ledger\nhash + receipt" as Ledger #F5F5F5
}

User -right-> MCP : request
MCP -right-> Release : candidate
Release -down-> Audit : commit
Audit -right-> Egress : receipt
Egress -down-> ExternalApp : package off-chain
ExternalApp -right-> Ledger : hash + proof
@enduml
